# GEMINI_API_KEY: Required for future Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# PORT: Server listening port
PORT=3000

# DATABASE_URL: PostgreSQL database connection string (used by Prisma ORM)
DATABASE_URL="postgresql://secondlife_user:secondlife_password@localhost:5432/secondlife?schema=public"

# JWT_SECRET: Secret key for signing and verifying JSON Web Tokens
JWT_SECRET="secondlife-production-jwt-secret-key-2026"

